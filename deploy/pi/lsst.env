# Data service configuration for the Pi. Copy to /etc/lsst/lsst.env.
# Two copies on the SD card's data partition, one on a separate USB drive (REQ-DAT-003).
LSST_LOG_COPIES=/data/lsst/log.A,/data/lsst/log.B,/media/lsst-usb/lsst/log.C
LSST_STATE=/data/lsst/state
LSST_WEB=/opt/lunar-sleep-shift/web/dist
LSST_HOST=127.0.0.1
LSST_PORT=8642
# gpio | sim
LSST_LIGHTS=gpio
# tsl2591 | sim
LSST_SENSOR=tsl2591
# gpio | sim   front keys, toggles, charger sense, ACK light (hardware/controls.py)
LSST_CONTROLS=gpio
# ina260 | sim  battery monitor on I2C 0x40
LSST_BATTERY=ina260
# sysfs | sim   Touch Display 2 backlight
LSST_BACKLIGHT=sysfs
# Run once, after the low-battery event is on disk (REQ-HW-013). setup.sh allows this one command via sudoers.
LSST_SHUTDOWN_CMD=sudo /usr/bin/systemctl poweroff
LSST_LOW_BATT_PCT=5
LSST_LOW_BATT_HOLD_S=30
# 1 for test and demo builds only (REQ-SAF-003). Faults also need the TEST switch on (REQ-HW-012).
LSST_ALLOW_FAULTS=1
